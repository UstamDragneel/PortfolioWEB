# ==========================================================================
# Copy this file to ".env" and fill in your own values.
# The real ".env" is git-ignored and blocked from browser access.
# ==========================================================================

# local = fall back to storage/outbox when Resend is not configured.
# production = never fall back; missing config is an error.
APP_ENV=local

# auto   = Resend when configured, otherwise local outbox (local only)
# resend = always call Resend
# log    = always write to storage/outbox, never send
MAIL_DRIVER=auto

# Resend API key (starts with "re_")
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend first.
# Example: Janmatsu.tech <hello@janmatsu.tech>
RESEND_FROM_EMAIL=

# Where contact-form messages are delivered.
# Comma-separate for more than one inbox.
CONTACT_TO_EMAIL=you@example.com

# Shown in the subject and body of notification emails.
SITE_NAME=Janmatsu.tech
